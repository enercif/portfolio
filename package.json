		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^22.20.2",
		"directus-sdk-typegen": "^0.2.1",
		"dotenv": "^17.4.2",
		"eslint": "^10.10.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"gsap": "^3.15.0",
		"mode-watcher": "^1.1.0",
